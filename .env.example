# Application
# Node.js execution environment: development | production | test
NODE_ENV=development
# Port the HTTP server listens on
PORT=3000
# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Stellar Network
# Stellar network to target: public | testnet
STELLAR_NETWORK=testnet
# Horizon endpoint for classic ledger data
HORIZON_URL=https://horizon-testnet.stellar.org
# Stellar RPC endpoint for Soroban contract events
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Database (PostgreSQL with TimescaleDB)
# PostgreSQL/Timescale connection string
DATABASE_URL=postgres://user:password@localhost:5432/stellar_analytics

# Redis (for queue, caching, rate limiting)
# Redis connection string
REDIS_URL=redis://localhost:6379

# Hubble/BigQuery historical backfill (optional)
# GCP project id holding the crypto_stellar dataset
BIGQUERY_PROJECT_ID=
# Path to a service-account JSON key file (empty = Application Default Credentials)
BIGQUERY_KEY_FILE=

# Security
# Salt for hashing API keys (min 16 characters)
API_KEY_SALT=your-super-secret-salt-min-16-chars
