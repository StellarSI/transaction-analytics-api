{
  "name": "transaction-analytics-api",
  "version": "0.0.1",
  "description": "APIs for real-time transaction flow insights on the Stellar network",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e"
  },
  "keywords": [
    "stellar",
    "analytics",
    "api",
    "transactions",
    "horizon",
    "soroban"
  ],
  "author": "StellarSI",
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "^12.0.0",
    "fastify": "^4.26.0",
    "ioredis": "^5.3.0",
    "zod": "^3.22.0",
    "drizzle-orm": "^0.30.0",
    "postgres": "^3.4.0",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.0",
    "@fastify/helmet": "^11.1.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/compress": "^6.5.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "prom-client": "^15.1.0",
    "argon2": "^0.40.0",
    "bullmq": "^5.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0",
    "tsx": "^4.7.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.0",
    "vitest": "^1.2.0",
    "@vitest/coverage-v8": "^1.2.0",
    "drizzle-kit": "^0.20.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}